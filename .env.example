# Copy to .env and fill in. `docker compose` reads .env automatically.

# Meilisearch admin key. Any string of 16+ bytes; generate one with:
#   openssl rand -hex 32
MEILI_MASTER_KEY=change-me-to-a-long-random-string

# Shared secret the MCP endpoint requires as `Authorization: Bearer <token>`.
# The server refuses to start without it unless MCP_ALLOW_ANONYMOUS=1.
#   openssl rand -hex 32
MCP_AUTH_TOKEN=change-me-to-a-long-random-string

# A real address you monitor. OpenStreetMap, Wikimedia and Nominatim all
# require it in the User-Agent and will block traffic that omits it.
CONTACT_EMAIL=you@example.com

# Optional: sites for the crawler to walk. `URL|Town` attributes pages that
# carry no coordinates of their own to that town; without it, an unlocatable
# page is dropped rather than indexed at a guessed position.
# CRAWL_SEEDS=https://www.visitgrandjunction.com|Grand Junction,https://www.denver.org|Denver

# Dashboard: shown on the public request page.
# PUBLIC_TITLE=Colorado guide
# PUBLIC_CONTACT=hello@example.com
# SUBMIT_PER_HOUR=10

# Optional overrides.
# SOURCE_INTERVALS=overpass=20m,wikipedia=15m,crawl=10m
# DISABLED_SOURCES=crawl
# RUST_LOG=info,bot=debug
#
# Production only: a search-only Meilisearch key for the MCP service.
# Create it with deploy/create-search-key.sh once Meilisearch is running.
# MEILI_SEARCH_KEY=
